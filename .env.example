# ===== CampusBazaar 环境变量模板 =====
# 使用方法：复制本文件为 .env，并填入真实值。切勿将 .env 提交到 Git。

# Flask 会话签名密钥（建议用长随机字符串）
SECRET_KEY=replace-with-a-long-random-secret
# JWT 签名密钥
JWT_SECRET_KEY=replace-with-another-long-random-secret
# Fernet 对称密钥（用 python backend/utils/miyao.py 生成）
ENCRYPTION_KEY=

# 数据库（MySQL）
DATABASE_URL=mysql+pymysql://root:your-password@localhost:3306/campus_bazaar

# Redis（缓存/验证码/会话数据）
REDIS_URL=redis://localhost:6379/0

# 运行模式：development / production
FLASK_ENV=development
