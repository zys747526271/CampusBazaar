# ===== CampusBazaar 环境变量模板 =====
# 复制为 .env 后按需修改；.env 已在 .gitignore 中，切勿提交。
# 本地开发甚至可以完全不建 .env：local 环境会自动生成并持久化开发用密钥。

# ---------- 运行环境 ----------
# local | testing | staging | production
CAMPUS_CONFIG=local

# ---------- 密钥（生产必填，缺失会拒绝启动）----------
SECRET_KEY=
JWT_SECRET_KEY=

# ---------- 数据库 ----------
# 本地默认 sqlite:///instance/campus.db；生产示例：
# DATABASE_URL=mysql+pymysql://user:password@127.0.0.1:3306/campus_bazaar?charset=utf8mb4
DATABASE_URL=

# ---------- 缓存 / Redis ----------
# staging / production 必填；local 使用进程内 SimpleCache
REDIS_URL=

# ---------- 业务开关 ----------
# 本地发布即通过；生产必须为 false 走人工审核
AUTO_APPROVE_PRODUCT=true
# dev 验证码回显（控制台 + /dev/captchas）；prod 走短信网关
CAPTCHA_MODE=dev
# 短信网关是否就绪：生产为 true，未接入时注册会返回 503，禁止静默放行
SMS_GATEWAY_ENABLED=false
# 演示数据（生产必须 false）
SEED_DEMO_DATA=true
# 管理员自助注册
ADMIN_REGISTRATION_ENABLED=true
# 生产环境管理员注册邀请码
ADMIN_REGISTER_INVITE_CODE=
# 定时任务（超时取消 / 自动确认收货）
ENABLE_SCHEDULER=true
SCHEDULER_INTERVAL_SECONDS=60
# 演示充值：无第三方支付通道时用于体验余额支付，生产必须 false
ENABLE_DEMO_RECHARGE=true
# 同一 IP 每 5 分钟注册次数（生产建议 5）
RATE_REGISTER_PER_5MIN=50

# ---------- 日志 ----------
LOG_LEVEL=DEBUG
# text | json（生产建议 json 便于采集）
LOG_FORMAT=text
LOG_RETENTION_DAYS=14

# ---------- 前端托管 ----------
# true 时由 Flask 托管 frontend/dist，实现"一条命令演示"
SERVE_FRONTEND=false
# 允许跨域的来源（本地走 Vite 代理，通常留空）
CORS_ORIGINS=
